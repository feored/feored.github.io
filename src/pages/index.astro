					"Desktop tool to draw pixel art directly in Trackmania 2 maps using custom blocks.",
				tech: "C#, .NET, Svelte, Photino, GBX.NET",
			},
			{
				title: "PyPlanet AFK Plugin",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/pyplanet-afk_spec",
					},
					{
						label: "PyPI",
						href: "https://pypi.org/project/pyplanet-afk-spec/",
					},
				],
				description:
					"Configurable PyPlanet plugin that detects inactive players and moves them to spectator mode.",
				tech: "Python, PyPlanet",
			},
		],
	},
	{
		title: "Misc",
		items: [
			{
				title: "Soundpost Tools",
				links: [
					{
						label: "Live demo",
						href: "https://feored.github.io/soundpost-tools",
					},
				],
				description:
					"Browser-based utilities for processing soundpost-style WebM files entirely on the client using ffmpeg.wasm.",
				tech: "SvelteKit, TypeScript, ffmpeg.wasm",
			},
			{
				title: "Lightweight Screenshot",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/screenshotext",
					},
					{
						label: "Chrome Web Store",
						href: "https://chromewebstore.google.com/detail/lightweight-screenshot/eapeifgbfommamnclhbppicejicnpooc",
					},
				],
				description:
					"Chrome extension for capturing full-page and region screenshots with minimal overhead.",
				tech: "Javascript",
			},
		],
	},
	{
		title: "Games",
		items: [
			{
				title: "Stormriders",
				links: [
					{
						label: "YouTube Preview",
						href: "https://www.youtube.com/watch?v=gKaFYDHo79I",
					},
				],
				description:
					"3D flight combat game with open world streaming, state-authoritative architecture, utility AI, and modular mission systems. Early prototype, built with a team of 7.",
				highlight: true,
				tech: "Godot, FMOD",
			},
			{
				title: "Neptune's Wake",
				highlight: true,
				links: [
					{
						label: "itch.io",
						href: "https://feor.itch.io/neptunes-wake",
					},
					{
						label: "LDjam",
						href: "https://ldjam.com/events/ludum-dare/54/neptunes-wake",
					},
					{
						label: "GitHub",
						href: "https://github.com/feored/NeptunesWake",
					},
				],
				description:
					"Strategy deckbuilder based on Dice Wars with data-driven cards, procedural generation and AI opponents using heuristic evaluations and lookahead. Originally built for Ludum Dare 54.",
				tech: "Godot",
			},
			{
				title: "The Lair of Kolekto",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/LD58",
					},
					{
						label: "itch.io",
						href: "https://feor.itch.io/the-lair-of-kolekto",
					},
					{
						label: "LDjam",
						href: "https://ldjam.com/events/ludum-dare/58/the-lair-of-kolekto",
					},
				],
				description:
					"Wave-survival arena game with diablo-style items, built for Ludum Dare 58.",
				tech: "Godot",
			},
			{
				title: "Carvest",
				links: [
					{
						label: "itch.io",
						href: "https://feor.itch.io/carvest",
					},
					{
						label: "LDjam",
						href: "https://ldjam.com/events/ludum-dare/52/carvset",
					},
				],
				description:
					"Top-down game about placing traps to cause mayhem on the road, built for Ludum Dare 52.",
				tech: "Godot",
			},
			{
				title: "Deep Impact",
				links: [
					{
						label: "itch.io",
						href: "https://feor.itch.io/deep-impact",
					},
					{
						label: "LDjam",
						href: "https://ldjam.com/events/ludum-dare/57/d-e-e-p-impact",
					},
				],
				description:
					"Arcade game based on 1977's Depthcharge, built for Ludum Dare 57.",
				tech: "Godot",
			},
			{
				title: "Tales of Sea City",
				links: [
					{
						label: "itch.io",
						href: "https://feor.itch.io/tales-of-sea-city",
					},
				],
				description: "Adventure game based on Gikopoi.",
				tech: "Godot",
			},
			{
				title: "Giko Idol",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/gikoidol",
					},
				],
				description: "Multiplayer minigame using the Gikobox backend.",
				tech: "Unity",
			},
			{
				title: "Gikobox",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/gikobox",
					},
				],
				description:
					"Jackbox-style backend for room-based party games with real-time messaging.",
				tech: "Node.js, Redis, WebSockets",
			},
		],
	},
];
---

<Layout>
	<main>
		<header>
			<p class="entry-links page-links">
				<a href="https://github.com/feored">github.com/feored</a>
			</p>
		</header>
		{
			sections.map((section) => (
				<section>
					<h2>{section.title}</h2>
					<ul class="entry-list">
						{section.items.map((item) => (
							<li
								class:list={[
									"entry",
									item.highlight && "entry--highlight",
								]}
							>
								<div class="entry-heading">
									<h3>{item.title}</h3>
									<p class="entry-links">
										{item.links.map((link, index) => (
											<>
												{index > 0 && (
													<span class="entry-links-separator">
														{" "}
														-{" "}
													</span>
												)}
												<a href={link.href}>
													{link.label}
												</a>
											</>
										))}
									</p>
								</div>
								<div class="entry-body">
									<p class="entry-description">
										{item.description}
									</p>
									<p class="entry-tech">{item.tech}</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<footer>
			<small>(&#180;&#12539;&#969;&#12539;&#96;)</small>
		</footer>
	</main>
</Layout>
