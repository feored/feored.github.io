				tech: "SvelteKit, TypeScript",
			},
			{
				title: "Autoblock",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/autoblock",
					},
				],
				description:
					"Desktop tool for batch-swapping materials and physics layers on Trackmania 2 custom block (.Gbx) files.",
				tech: "C#, .NET, GBX.NET",
			},
			{
				title: "Blockdraw",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/blockdraw",
					},
				],
