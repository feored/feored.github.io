---
import Layout from "../layouts/Layout.astro";

const sections = [
	{
		title: "Diablo II",
		items: [
			{
				title: "Halbu Editor",
				highlight: true,
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/halbu-editor",
					},
					{
						label: "Releases",
						href: "https://github.com/feored/halbu-editor/releases",
					},
				],
				description:
					"Diablo II: Resurrected save editor with validation, backups, and templates, built for safe editing of binary .d2s files across versions, including recovery from malformed saves.",
				tech: "Tauri, Svelte, TypeScript, Rust",
			},
			{
				title: "Halbu",
				highlight: true,
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/halbu",
					},
					{
						label: "crates.io",
						href: "https://crates.io/crates/halbu",
					},
				],
				description:
					"Rust library for parsing, editing, validating, and safely re-encoding D2R .d2s save files, with strict and tolerant parsing modes and preservation of unknown data for round-trip safety.",
				tech: "Rust",
			},
			{
				title: "Runeword Explorer",
				links: [
					{
						label: "GitHub",
						href: "https://github.com/feored/runeword-explorer",
