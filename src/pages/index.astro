---

<Layout>
	<main>
		<header>
			<p class="entry-links page-links">
				<a href="https://github.com/feored">github.com/feored</a>
			</p>
		</header>
		{
			sections.map((section) => (
				<section>
					<h2>{section.title}</h2>
					<ul class="entry-list">
						{section.items.map((item) => (
							<li
								class:list={[
									"entry",
									item.highlight && "entry--highlight",
								]}
							>
								<div class="entry-heading">
									<h3>{item.title}</h3>
									<p class="entry-links">
										{item.links.map((link, index) => (
											<>
												{index > 0 && (
													<span class="entry-links-separator">
														{" "}
														-{" "}
													</span>
												)}
												<a href={link.href}>
													{link.label}
												</a>
											</>
										))}
									</p>
								</div>
								<div class="entry-body">
									<p class="entry-description">
										{item.description}
									</p>
									<p class="entry-tech">{item.tech}</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<footer>
			<small>(&#180;&#12539;&#969;&#12539;&#96;)</small>
		</footer>
	</main>
</Layout>
